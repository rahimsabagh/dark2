<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature-level permission to restrict service binding strictly to apps signed with the same developer certificate -->
    <permission
        android:name="com.v2ray.helper.permission.BIND_MINING_SERVICE"
        android:protectionLevel="signature" />

    <!-- Foreground service and notification permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="XMRig Helper"
        android:supportsRtl="true">

        <!--
            Foreground Service:
            - Exported with signature-level permission protection
            - Uses specialUse foreground service type with designated subtype property
            - Runs as a Foreground Service ONLY when the user explicitly starts mining
            - No auto-start, no boot receiver
        -->
        <service
            android:name=".service.MiningHelperService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="com.v2ray.helper.permission.BIND_MINING_SERVICE">
            <intent-filter>
                <action android:name="com.v2ray.helper.ACTION_BIND_MINING" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-authorized background compute and network verification service" />
        </service>

        <!-- No Launcher Activity or launcher category intent-filter. The Helper APK is headless. -->
    </application>

</manifest>
